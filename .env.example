# ==============================================================================
# e7na Local - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' or '.env' for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit '.env', '.env.local', or production credentials to Git.
# 2. Only variables prefixed with 'VITE_' will be exposed to the client bundle by Vite.
# 3. For CI/CD and production environments, configure these via GitHub Actions Secrets,
#    Docker build arguments, or cloud provider environment management.
# ==============================================================================

# --- Application Configuration ---
VITE_APP_NAME="e7na Local"
VITE_APP_ENV="development" # Options: development | staging | production
VITE_APP_URL="http://localhost:5173"

# --- Admin Command Center Authentication ---
# Override the administrative login credentials for the Mall Command Center.
# Default fallback if unset: Username="Admin", Password="Password@26"
VITE_ADMIN_USERNAME="Admin"
VITE_ADMIN_PASSWORD="Password@26"

# --- Internationalization & Currency Defaults ---
VITE_DEFAULT_LANGUAGE="en" # Options: "en" (English) | "ar" (Arabic)
VITE_DEFAULT_CURRENCY="EGP" # Options: "EGP" (Egyptian Pound) | "USD" (US Dollar)

# --- Backend API & Webhook Endpoints (Optional / Future Services) ---
VITE_API_BASE_URL="https://api.e7nalocal.com/v1"
VITE_API_TIMEOUT_MS=15000

# --- Payment Gateways (Client Public Keys Only) ---
# CAUTION: Never put secret/private API keys here. Client-side code only handles public tokens.
VITE_PAYMOB_PUBLIC_KEY="pk_test_sample_paymob_public_key_000000"
VITE_FAWRY_MERCHANT_CODE="sample_fawry_merchant_code"

# --- Telemetry, Error Reporting & Analytics (Optional) ---
VITE_ENABLE_ANALYTICS=false
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_SENTRY_DSN=""

# --- Production Web Server / Docker Container Settings (Non-Vite) ---
PORT=80
NODE_ENV=production
